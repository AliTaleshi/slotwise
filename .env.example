# Database
DB_URL=jdbc:postgresql://localhost:5432/slotwise
DB_USER=slotwise
DB_PASSWORD=slotwise

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Set to "ecs" for structured JSON logs
LOGGING_STRUCTURED_FORMAT_CONSOLE=

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# Booking
HOLD_TTL=10m
# Base URL used in manage links sent to guests
PUBLIC_BASE_URL=http://localhost:8080

# Mail (Mailpit in docker-compose: host mailpit, port 1025, UI on 8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Slotwise <no-reply@slotwise.local>

# Webhooks: set true only in dev to allow http/localhost targets
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# Rate limiting (per client IP, per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
